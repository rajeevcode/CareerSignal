# ── Supabase ───────────────────────────────────────────────────────────────
# Local: get these from `supabase start` / `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>
SUPABASE_SERVICE_ROLE_KEY=<secret/service-role key>   # server-only, never in client
SUPABASE_URL=http://localhost:54321                    # for seed scripts
# Privileged direct Postgres connection (Next.js Drizzle data layer + Python AI service).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI Service
AI_SERVICE_URL=http://localhost:8011
OPENAI_API_KEY=sk-your-openai-key
# Shared secret authenticating the Next.js backend to the AI service. The AI
# service does NO per-user authz of its own, so REQUIRED in any environment
# where its port is reachable from outside the host. Both values must match.
# Next.js sends it as X-Internal-Token; the AI service reads INTERNAL_API_TOKEN.
AI_INTERNAL_TOKEN=
INTERNAL_API_TOKEN=

# ── Stripe (Phase 6 scaffold — not wired for production yet) ────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY=
# Optional: OpenRouter or other OpenAI-compatible provider
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# EMBEDDING_MODEL=openai/text-embedding-3-small
# OpenRouter keys (sk-or-v1-...) are detected automatically.

# ── LLM spend circuit-breaker ───────────────────────────────────────────────
# Global (all-users) USD ceilings on LLM API spend, enforced by the AI service
# before each call (model + token cost is recorded in the llm_spend ledger).
# When a window's rolling spend hits its cap, LLM endpoints return HTTP 503
# until the window resets (daily at 00:00 UTC, monthly on the 1st). Set 0 or a
# negative value to make a window unlimited. Defaults: 50/day, 1000/month.
# LLM_DAILY_BUDGET_USD=50
# LLM_MONTHLY_BUDGET_USD=1000
# Optional per-model price overrides (USD per 1M tokens), merged over built-in
# defaults — adjust prices or add a model without a code change:
# LLM_PRICE_OVERRIDES={"gpt-4o":{"input":2.5,"output":10},"openai/gpt-4o-mini":{"input":0.15,"output":0.6}}

# ── Social OAuth (optional) ─────────────────────────────────────────────────
# Providers are turned on in supabase/config.toml ([auth.external.*]); these
# creds must be EXPORTED into the shell that runs `supabase start` (config.toml
# resolves them via env(...)). The UI reads GoTrue's public provider settings,
# so a provider appears automatically once Supabase has enabled it. Register
# http://127.0.0.1:54321/auth/v1/callback as an authorized redirect URL in each
# provider's console. Leave credentials empty to disable the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Mock checkout (DEV ONLY). When 'true', /api/checkout/complete grants Pro
# without a real payment. Leave unset/empty everywhere except local dev — never
# set this in staging/preview/production, where Pro must come from a verified
# payment webhook.
ALLOW_MOCK_CHECKOUT=true

# Application confirmation emails (optional — Resend)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=CareerSignal <notifications@yourdomain.com>

# FastAPI (services/ai/.env)
# Production container settings
AI_WORKERS=2
WEB_PORT=3000
BIND_ADDRESS=0.0.0.0

# Career workspace Google read-only connections (separate from Supabase sign-in).
# Configure the client above, enable Gmail/Calendar APIs, and register this callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback
# Generate with: openssl rand -base64 32. Keep server-only and retain it to decrypt stored tokens.
CAREER_TOKEN_ENCRYPTION_KEY=
