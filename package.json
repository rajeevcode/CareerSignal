{
  "name": "careersignal",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @careersignal/web --filter @careersignal/ai dev",
    "dev:web": "pnpm --filter @careersignal/web dev",
    "dev:ai": "pnpm --filter @careersignal/ai dev",
    "build": "pnpm --filter @careersignal/shared build && pnpm --filter @careersignal/db build && pnpm --filter @careersignal/web build",
    "lint": "pnpm --filter @careersignal/web lint",
    "db:push": "pnpm --filter @careersignal/db db:push",
    "db:seed": "pnpm --filter @careersignal/db db:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
