# ── Supabase ───────────────────────────────────────────────────────────────
# Local: get these from `supabase start` / `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>
SUPABASE_SERVICE_ROLE_KEY=<secret/service-role key>   # server-only, never in client
SUPABASE_URL=http://127.0.0.1:54321                    # for seed scripts
# Privileged direct Postgres connection (Next.js Drizzle data layer + Python AI service).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI Service
AI_SERVICE_URL=http://localhost:8011
OPENAI_API_KEY=sk-your-openai-key

# ── Stripe (Phase 6 scaffold — not wired for production yet) ────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY=
# Optional: OpenRouter or other OpenAI-compatible provider
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# EMBEDDING_MODEL=openai/text-embedding-3-small
# OpenRouter keys (sk-or-v1-...) are detected automatically.

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application confirmation emails (optional — Resend)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=CareerSignal <notifications@yourdomain.com>

# FastAPI (services/ai/.env)
# DATABASE_PATH should point to the same file as above
